# === BIM Timesheet API — Environment Variables ===

# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Database — BIMdb (cbimtech_TimeSheetWeb)
BIM_DB_SERVER=localhost
BIM_DB_PORT=1433
BIM_DB_NAME=cbimtech_TimeSheetWeb
BIM_DB_USER=sa
BIM_DB_PASSWORD=your_strong_password_here
BIM_DB_ENCRYPT=false
BIM_DB_TRUST_CERT=true
BIM_DB_POOL_MAX=10
BIM_DB_POOL_MIN=2

# Database — DMCdb (cbimtech_dmc)
DMC_DB_SERVER=localhost
DMC_DB_PORT=1433
DMC_DB_NAME=cbimtech_dmc
DMC_DB_USER=sa
DMC_DB_PASSWORD=your_strong_password_here
DMC_DB_ENCRYPT=false
DMC_DB_TRUST_CERT=true

# JWT
JWT_ACCESS_SECRET=change_this_to_a_very_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional — for caching)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Anthropic / Claude AI
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6
AI_ENABLED=true
AI_MAX_TOKENS=4096
AI_RATE_LIMIT_PER_HOUR=20

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Timezone
TZ=Asia/Ho_Chi_Minh
