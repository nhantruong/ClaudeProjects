# ─────────────────────────────────────────────────────────────────────────────
# Raphael API — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# URL of the React frontend (used for CORS origin allowlist)
CLIENT_URL=http://localhost:5173

# ── MS SQL Server ─────────────────────────────────────────────────────────────
# Hostname or IP of the SQL Server instance
DB_SERVER=
# Default SQL Server port; change if instance uses a non-standard port
DB_PORT=1433
# Name of the Raphael database
DB_NAME=
# SQL Server login credentials
DB_USER=
DB_PASSWORD=
# Set to true if the server requires an encrypted connection (Azure SQL, etc.)
DB_ENCRYPT=false
# Set to true for local/self-signed certificates (local dev only)
DB_TRUST_SERVER_CERTIFICATE=true

# ── Authentication ────────────────────────────────────────────────────────────
# Must be at least 32 characters — used to sign JWTs (ADR-002)
# Generate a strong secret: openssl rand -base64 48
SESSION_SECRET=

# ── AI Advisor ────────────────────────────────────────────────────────────────
# Provider to use: 'anthropic' (cloud) or 'ollama' (local) — ADR-003
AI_PROVIDER=anthropic
# Required when AI_PROVIDER=anthropic — your Anthropic API key
AI_API_KEY=
# Required when AI_PROVIDER=ollama — base URL of local Ollama instance
OLLAMA_URL=http://localhost:11434
# Ollama model name (only used when AI_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2
